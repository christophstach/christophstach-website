{
  // Covers the Solid app only. The Nuxt sources (app/, server/api,
  // server/routes, server/utils, nuxt.config.ts) stay as reference until
  // they're removed, and aren't checked.
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  // solid-env.d.ts and file-routes.d.ts are generated by the dev server and
  // the build (from env.ts and src/routes) and committed, so a fresh clone
  // typechecks.
  "include": ["src", "server/db", "env.ts", "vite.config.ts", "solid-env.d.ts", "file-routes.d.ts"],
  "exclude": ["app", "server/api", "server/routes", "server/utils", "nuxt.config.ts"]
}
