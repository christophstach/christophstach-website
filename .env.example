# Seals the session cookie. At least 32 characters.
NUXT_SESSION_PASSWORD=

# GitHub OAuth app. Callback URL: <origin>/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Numeric GitHub user ID of the only account allowed into /desk.
NUXT_DESK_GITHUB_ID=

# Optional: Chrome for rendering the CV PDF locally (the bundled serverless
# Chromium only runs on Linux), e.g.
# /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
NUXT_CV_PDF_CHROME=

# Postgres (Neon) holding the CV variants. On Vercel the Neon integration sets
# both; locally, `vercel env pull .env` copies them, or point them at any
# Postgres. The app connects through the pooled URL (the "-pooler" host);
# migrations (pnpm db:migrate, and the Vercel build) prefer the unpooled one.
# The other variables the integration adds (PG*, POSTGRES_*) are unused.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# Lets the desk renew the cached public CV PDF after the primary variant
# changes (Vercel on-demand ISR). Any random string of 32+ characters, e.g.
# from `openssl rand -base64 32`; must be set for the build as well as at runtime.
NUXT_ISR_BYPASS_TOKEN=
