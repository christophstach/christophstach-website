# Copy to .env and fill in. Validated at server start by env.ts.

# Signs and encrypts the desk session cookie. At least 32 characters; comma-separated
# to rotate, newest first, e.g. openssl rand -base64 32.
SESSION_SECRET=

# GitHub OAuth app. Callback URL: <origin>/auth/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Numeric GitHub user ID of the only account allowed into /desk.
DESK_GITHUB_USER_ID=

# Postgres (Neon). On Vercel the Neon integration sets both. The app connects
# through the pooled URL (the "-pooler" host); migrations (pnpm db:migrate, and
# the Vercel build) prefer the unpooled one.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# Optional: Chrome for printing the CV PDF off Linux (the bundled serverless
# Chromium only runs on Linux), e.g.
# /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CV_PDF_CHROME_PATH=

# Optional locally: lets the desk renew the cached public data and CV PDF after
# a change (Vercel on-demand ISR). Any random string of 32+ characters; must be
# set for the build as well as at runtime.
ISR_BYPASS_TOKEN=
