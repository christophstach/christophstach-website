{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc", "promise", "node"],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "rules": {
    "eqeqeq": "error",
    // Solid props are read-only proxies typed as plain objects; marking every component
    // parameter Readonly<> adds noise without catching anything.
    "typescript/prefer-readonly-parameter-types": "off",
    // The ported body parsers check every field with a type guard and then assert the
    // checked shape; rewriting them as schemas is out of scope for the port.
    "typescript/no-unsafe-type-assertion": "off",
    // Truthiness checks on strings and query results are deliberate here (an empty
    // string counts as missing), as in the code this was ported from.
    "typescript/strict-boolean-expressions": "off",
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "no-console": "error",
    "no-debugger": "error",
    "no-underscore-dangle": ["error", { "allow": ["__BUILD_ID__"] }],
    "capitalized-comments": "off",
    "sort-keys": "off",
    "no-ternary": "off",
    "one-var": "off",
    "func-style": "off",
    "no-magic-numbers": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "server-only", "client-only"] }
    ],
    "unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }]
  },
  "ignorePatterns": [
    ".nuxt",
    ".output",
    ".vercel",
    "dist",
    "node_modules",
    "app",
    "server/api",
    "server/routes",
    "server/utils",
    "nuxt.config.ts",
    "file-routes.d.ts",
    "solid-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["src/server/**"],
      "env": { "node": true, "browser": false }
    },
    {
      "files": ["scripts/**"],
      "env": { "node": true, "browser": false },
      "rules": {
        "import/no-nodejs-modules": "off",
        "no-console": "off",
        "no-promise-executor-return": "off",
        "node/no-sync": "off",
        "promise/avoid-new": "off"
      }
    }
  ]
}
