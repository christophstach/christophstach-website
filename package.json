{
  "name": "christophstach-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "vercel-build": "drizzle-kit migrate && vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "a11y": "node tools/a11y.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@solidjs/meta": "2.0.0",
    "@solidjs/router": "2.0.1",
    "@solidjs/web": "2.0.4",
    "@sparticuz/chromium": "153.0.0",
    "ai": "7.0.183",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.6",
    "nitro": "3.0.261103-rc",
    "postgres": "^4.1.1",
    "puppeteer-core": "25.19.0",
    "solid-js": "2.0.4",
    "unpdf": "2.2.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.7",
    "@solidjs/diagnostics": "2.0.4",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "24.19.4",
    "axe-core": "4.14.1",
    "drizzle-kit": "^0.31.11",
    "filesystem-routing": "0.5.0",
    "lefthook": "2.2.4",
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "secretlint": "14.1.0",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.23.0"
}
